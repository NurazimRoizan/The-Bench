generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id             String   @id @default(uuid())
  name           String
  category       String
  concept        String
  targetAudience String
  status         String
  techStack      String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
