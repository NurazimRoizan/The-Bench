generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id             String   @id @default(uuid())
  name           String
  category       String
  concept        String
  targetAudience String?
  status         String   @default("IDEA") // IDEA, IN_PROGRESS, SHIPPED
  techStack      String[]
  features       String[]
  monetization   String?
  competitors    String[]
  userId         String
  tasks          Task[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Task {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
